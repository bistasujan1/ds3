# DS3 Application Environment
ENVIRONMENT=local

# Primary Database (all portal users connect to the same DB, isolated by grants)
DB_HOST_NAME=localhost
DB_NAME=ds3

# Admin portal DB user (full read/write)
ADMIN_DB_USER_NAME=root
ADMIN_DB_PASSWORD=

# Default DB user (token verification, public/cron routes)
DB_USER_NAME=root
DB_PASSWORD=

# Audit Database (can point to same host as primary in dev)
AUDIT_DB_HOST_NAME=localhost
AUDIT_DB_NAME=ds3_audit
AUDIT_DB_USER_NAME=root
AUDIT_DB_PASSWORD=

# Logging (RFC 5424 severity: 7=debug, 4=warning, 3=error)
LOG_LEVEL=7
LOG_DIR=C:/xampp/htdocs/ds3/storage/logs

# App
SITE_URL=http://local.ds3.com
DB_SSL=false

# Email (SendGrid)
SENDGRID_API_KEY=

# SMS (Telnyx)
TELNYX_API_KEY=
TELNYX_FROM_NUMBER=

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET=
